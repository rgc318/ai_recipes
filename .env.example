# Runtime
ENV=dev
PORT=8000
LOG_LEVEL=debug

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ai_recipes

# Logging
LOG_ENABLE_FILE=true

# Security
JWT_SECRET=change-me-to-a-long-random-secret
TESTING_MODE=false

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# MinIO / S3 compatible storage
MINIO_ACCESS_KEY=minio
MINIO_SECRET=minio123

PRIVATE_STORAGE_ENDPOINT=127.0.0.1:9000
PRIVATE_STORAGE_BUCKET=secure-files-bucket
PRIVATE_STORAGE_SECURE=false

PUBLIC_STORAGE_ENDPOINT=127.0.0.1:9000
PUBLIC_STORAGE_BUCKET=public-assets-bucket
PUBLIC_STORAGE_SECURE=false
PUBLIC_STORAGE_SECURE_CDN=false
PUBLIC_STORAGE_PUBLIC_ENDPOINT=127.0.0.1:9000

# Optional Cloudflare R2 profile
R2_ACCESS_KEY=
R2_SECRET_KEY=

# Container healthcheck
HEALTHCHECK_PATH=/api/v1/auth/health

# Optional integration-test login account
TEST_AUTH_USERNAME=
TEST_AUTH_PASSWORD=
